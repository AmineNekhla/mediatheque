# Copier ce fichier en .env.local pour un usage hors Docker. Ne jamais y mettre de vrais secrets.

APP_ENV=dev
APP_SECRET=changez-moi

# Base MySQL 8 (hors Docker : exposer le port 3306 du conteneur ou utiliser un MySQL local)
DATABASE_URL="mysql://app:app@127.0.0.1:3306/mediatheque?serverVersion=8.0&charset=utf8mb4"

# Variables facultatives de Docker Compose (valeurs par défaut entre parenthèses)
# APP_PORT=8000            # port web sur votre machine
# LOAD_DEMO_DATA=1         # 0 pour démarrer avec une base vide
# MYSQL_DATABASE=mediatheque
# MYSQL_USER=app
# MYSQL_PASSWORD=app
# MYSQL_ROOT_PASSWORD=root
