{% extends 'layout.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
<div class="carte" style="max-width: 420px; margin: 2rem auto;">
    <h1>Connexion</h1>

    {% if erreur %}
        <p class="erreur">Identifiants invalides.</p>
    {% endif %}

    <form method="post">
        <label for="email">E-mail</label>
        <input type="email" id="email" name="_username" value="{{ dernier_email }}" autocomplete="email" required autofocus>

        <label for="mdp">Mot de passe</label>
        <input type="password" id="mdp" name="_password" autocomplete="current-password" required>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <button type="submit">Se connecter</button>
    </form>
</div>
{% endblock %}